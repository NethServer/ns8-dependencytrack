{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>NethServer/.github:ns8-automerge"
  ],
  "packageRules": [
    {
      "description": "The v4-migrator must always match the apiserver version",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "dependencytrack/apiserver",
        "dependencytrack/frontend",
        "ghcr.io/dependencytrack/v4-migrator"
      ],
      "groupName": "dependency-track"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["nginx"],
      "allowedVersions": "<1.31"
    }
  ]
}
