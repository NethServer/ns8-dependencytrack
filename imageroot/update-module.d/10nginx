# nginx/default.conf is only written at create-module, so an instance updated in
# place keeps the file it was installed with. 20restart recreates the container
# right after and picks the new one up.

set -e

# Redirect any output to the journal (stderr)
exec 1>&2

../actions/create-module/30expand_nginx_config
